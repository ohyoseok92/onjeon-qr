[Unit]
Description=Verify and publish registered Onjeon issuer CRLs
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
OnFailure=onjeon-operation-alert.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker run --rm --read-only --tmpfs /tmp:rw,noexec,nosuid,size=16m --memory 128m --pids-limit 64 --cap-drop ALL --security-opt no-new-privileges:true --user 10001:10001 -v /srv/onjeon-qr/runtime:/ops:ro -v /srv/onjeon-qr/profile/tls:/var/onjeon-tls:rw -v /srv/onjeon-qr/ops-custody:/var/onjeon-custody:rw --entrypoint python sha256:1b5c6bed0b940e956d1debb854a9e2d14ec5e848a3475de9da4ee1ad709ef910 /ops/refresh_operational_crls.py --config /var/onjeon-tls/sources.json --custody /var/onjeon-custody/crl --bundle /var/onjeon-tls/revocations.pem --issuers /var/onjeon-tls/issuers.pem
TimeoutStartSec=180
UMask=0077

